# URL base de tu API compartida (sin barra al final)
VITE_API_URL=http://localhost:4000/api

# Identificador de este sitio. La API filtra el contenido por este valor
# (campo "sitios" en proyectos, servicios y testimonios)
VITE_SITE=code

# WhatsApp con indicativo de país, sin + ni espacios (ej: 573001234567)
VITE_WHATSAPP=573000000000

# Datos de contacto que se muestran en la web
VITE_EMAIL=contacto@tudominio.com
VITE_INSTAGRAM=https://www.instagram.com/pandaxcode/
VITE_YOUTUBE=https://www.youtube.com/@pandaxcode9228

# Enlace a la tienda (PandaX Tech) para la barra superior
VITE_TIENDA_URL=#
